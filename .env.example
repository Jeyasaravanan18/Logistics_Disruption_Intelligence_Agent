# Environment: development | production
ENVIRONMENT=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=logistics

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Browser origin(s) allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# Optional live integrations (pipeline still runs with empty signals if omitted)
OPENWEATHER_API_KEY=
GNEWS_API_KEY=
GEMINI_API_KEY=
